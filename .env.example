# =========================
# AI Models — Required
# =========================
GROQ_API_KEY=                       # https://console.groq.com
GOOGLE_API_KEY=                     # https://aistudio.google.com

# Optional alternative LLMs
OPENAI_API_KEY=

# =========================
# Search — Required
# =========================
TAVILY_API_KEY=                     # https://app.tavily.com

# =========================
# Vector Database — Required
# =========================
QDRANT_URL=http://localhost:6333    # https://cloud.qdrant.io
QDRANT_API_KEY=

# =========================
# Optional: Redis Cache
# =========================
REDIS_URL=redis://localhost:6379/0

# =========================
# Optional: LangSmith Tracing
# Get key at https://smith.langchain.com
# =========================
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=multi-agent-research-assistant
