# =========================
# AI Models — Required
# =========================
GROQ_API_KEY=                       # https://console.groq.com  (Researcher, Critic, Reporter, Doubt)
GOOGLE_API_KEY=                     # https://aistudio.google.com  (Router, Planner — Gemini models)

# =========================
# Search — Required
# =========================
TAVILY_API_KEY=                     # https://app.tavily.com

# =========================
# Vector Database — Required
# =========================
QDRANT_URL=http://localhost:6333    # https://cloud.qdrant.io
QDRANT_API_KEY=

# =========================
# App Security
# =========================
APP_API_KEY=                        # If set, all endpoints (except GET /health) require X-API-Key header
ALLOWED_ORIGINS=http://localhost:7860  # Comma-separated list of allowed CORS origins

# =========================
# Data & Model Storage
# =========================
DATA_DIR=./data                     # Directory for SQLite databases and logs
MODEL_CACHE_DIR=./model_cache       # Directory for SentenceTransformer model weights

# =========================
# Optional — Observability
# =========================
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=multi-agent-research

# =========================
# Optional — Tuning
# =========================
AGENT_TIMEOUT=120                   # Per-agent timeout in seconds
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1
